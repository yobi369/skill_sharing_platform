{
  "name": "skillchain-marketplace",
  "version": "0.3.0",
  "private": true,
  "description": "SkillChain skill-sharing marketplace prototype and API",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
