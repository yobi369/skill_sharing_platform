  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "bcryptjs": "^2.4.3",
    "@fastify/cors": "^10.0.2"
  },
  "devDependencies": {}
}
