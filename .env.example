# Copy to .env locally; never commit real credentials.
# For compose.yaml, use the database service hostname shown below.
DATABASE_URL=postgres://skillchain:change-me-use-a-unique-local-password@database:5432/skillchain
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
POSTGRES_DB=skillchain
POSTGRES_USER=skillchain
POSTGRES_PASSWORD=change-me-use-a-unique-local-password
PORT=3000
API_PORT=3000
# Comma-separated exact frontend origins. Leave unset to deny browser cross-origin access.
CORS_ORIGINS=http://localhost:8000
# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
DB_POOL_MAX=10
