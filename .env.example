# Copy to .env locally; never commit real credentials.
DATABASE_URL=postgres://skillchain:change-me-use-a-unique-local-password@database:5432/skillchain
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
POSTGRES_DB=skillchain
POSTGRES_USER=skillchain
POSTGRES_PASSWORD=change-me-use-a-unique-local-password
PORT=3000
API_PORT=3000
# Exact public frontend origin(s), comma-separated. No wildcard origins.
CORS_ORIGINS=http://localhost:8000
# Set to true in production only after SMTP delivery is configured and tested.
REQUIRE_EMAIL_VERIFICATION=false
FRONTEND_URL=http://localhost:8000/web
# SMTP settings are required for production verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Only set true when deployed behind a trusted reverse proxy.
TRUST_PROXY=false
DB_POOL_MAX=10
# Optional Redis URL for a future distributed rate-limit adapter; current limits are per instance.
REDIS_URL=
