# Copy to .env locally; never commit real credentials.
DATABASE_URL=postgres://skillchain:change-me@localhost:5432/skillchain
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
PORT=3000
HOST=0.0.0.0
# Comma-separated exact frontend origins. Leave unset to deny browser cross-origin access.
CORS_ORIGINS=http://localhost:8000
# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
DB_POOL_MAX=10
